$bog_kit_layout $mol_book2_catalog
	param \block
	menu_title \Layout
	spreads *
		row <= Row_page $mol_page
			title \$mol_row
			Logo <= Spread_close
			body /
				<= Rows $mol_list
					rows /
						<= Row_label $mol_labeler
							title \Row wraps its content
							Content <= Row $mol_row
								sub /
									<= Row_one $mol_button_minor
										title \One
									<= Row_two $mol_button_minor
										title \Two
									<= Row_three $mol_button_minor
										title \Three
						<= Bar_label $mol_labeler
							title \Bar glues controls into one
							Content <= Bar $mol_bar
								sub /
									<= Bar_query $mol_string
										hint \Query
										value? <=> bar_query? \
									<= Bar_submit $mol_button_minor
										title \Go
		list <= List_page $mol_page
			title \$mol_list
			Logo <= Spread_close
			body /
				<= List $mol_list
					rows /
						<= List_first $mol_card
							title \First
							content /
								\Rows are rendered only while visible.
						<= List_second $mol_card
							title \Second
							content /
								\Height of an unseen row is guessed, not measured.
						<= List_third $mol_card
							title \Third
							content /
								\That is why a million rows still scroll smoothly.
		deck <= Deck_page $mol_page
			title \$mol_deck
			Logo <= Spread_close
			body /
				<= Deck $mol_deck
					items /
						<= Deck_greeting $mol_card
							title \Greeting
							content /
								\Hello, world!
						<= Deck_question $mol_card
							title \Question
							content /
								\How are you?
						<= Deck_answer $mol_card
							title \Answer
							content /
								\42
		expander <= Expander_page $mol_page
			title \$mol_expander
			Logo <= Spread_close
			body /
				<= Expanders $mol_list
					rows /
						<= Expander_first $mol_expander
							title \Collapsed by default
							content /
								<= Expander_first_body $mol_paragraph
									sub /
										\Content is not even instantiated until you open it.
						<= Expander_second $mol_expander
							title \Nested one
							content /
								<= Expander_inner $mol_expander
									title \One level deeper
									content /
										<= Expander_inner_body $mol_paragraph
											sub /
												\Expanders nest as deep as you need.
		section <= Section_page $mol_page
			title \$mol_section
			Logo <= Spread_close
			body /
				<= Section $mol_section
					title \Section with tools
					tools /
						<= Section_tool $mol_button_minor
							title \Action
					content /
						<= Section_body $mol_paragraph
							sub /
								\A heading, a row of tools and a body.
						<= Section_inner $mol_section
							level +2
							title_dom_name \h2
							title \Nested section
							content /
								<= Section_inner_body $mol_paragraph
									sub /
										\Level is passed by hand, the tag too.
		scroll <= Scroll_page $mol_page
			title \$mol_scroll
			Logo <= Spread_close
			body /
				<= Scroll $mol_scroll
					sub /
						<= Scroll_filler $mol_filler

$mol_avatar $mol_icon
	view_box \0 0 24 24
	id \
	path \M 12 12 l 0 0 M 0 0 l 0 0 M 24 24 l 0 0 M 0 24 l 0 0 M 24 0 l 0 0

$mol_chip $mol_view
	minimal_height 40
	attr *
		^
		title <= hint \
	sub /
		<= title

$bog_kit_data $mol_book2_catalog
	param \view
	menu_title \Data
	spreads *
		card <= Card_page $mol_page
			title \$mol_card
			Logo <= Spread_close
			body /
				<= Cards $mol_list
					rows /
						<= Card_plain $mol_card
							title \Plain card
							content /
								\Just a titled island of content.
						<= Card_status $mol_card
							title \Card with status
							status \pending
							content /
								\The status goes to a footer and to an attribute.
						<= Card_rich $mol_card
							title \Card with a control inside
							Content <= Card_rich_content $mol_row
								sub /
									<= Card_rich_ok $mol_button_major
										title \Accept
									<= Card_rich_no $mol_button_minor
										title \Decline
		labeler <= Labeler_page $mol_page
			title \$mol_labeler
			Logo <= Spread_close
			body /
				<= Labelers $mol_list
					rows /
						<= Labeler_text $mol_labeler
							title \Provider
							content /
								\ACME Provider Inc.
						<= Labeler_control $mol_labeler
							title \User name
							Content <= Labeler_control_field $mol_string
								hint \Jack Sparrow
								value? <=> user_name? \
		grid <= Grid_page $mol_page
			title \$mol_grid
			Logo <= Spread_close
			body /
				<= Grid $mol_grid
					records *
						ada *
							name \Ada Lovelace
							role \Analyst
							score +99
						alan *
							name \Alan Turing
							role \Cryptographer
							score +97
						grace *
							name \Grace Hopper
							role \Compiler
							score +95
		text <= Text_page $mol_page
			title \$mol_text
			Logo <= Spread_close
			body /
				<= Text $mol_text
					text \
						\# Markdown right in the view
						\
						\`$mol_text` renders a subset of Markdown without any parser
						\dependency, and every block is a regular component.
						\
						\- lists
						\- **bold** and *italic*
						\- [links](https://mol.hyoo.ru/)
						\
						\> A quote is a nested `$mol_text`.
						\
						\```
						\const answer = 42
						\```
		avatar <= Avatar_page $mol_page
			title \$mol_avatar
			Logo <= Spread_close
			body /
				<= Avatars $mol_list
					rows /
						<= Avatar_id_label $mol_labeler
							title \Id
							Content <= Avatar_id $mol_string
								value? <=> avatar_id? \$bog_kit
						<= Avatar_label $mol_labeler
							title \Generated from the id
							Content <= Avatar $mol_avatar
								id <= avatar_id
						<= Chips_label $mol_labeler
							title \$mol_chip
							Content <= Chips $mol_row
								sub /
									<= Chip_one $mol_chip
										title \draft
									<= Chip_two $mol_chip
										title \review
										hint \Waiting for a reviewer
									<= Chip_three $mol_chip
										title \done

$mol_pop_over $mol_pop
	showed <= hovered? false
	attr *
		^
		tabindex 0
	event *
		^
		mouseenter? <=> event_show? null
		mouseleave? <=> event_hide? null

$bog_kit_feedback $mol_book2_catalog
	param \signal
	menu_title \Feedback
	spreads *
		status <= Status_page $mol_page
			title \$mol_status
			Logo <= Spread_close
			body /
				<= Statuses $mol_list
					rows /
						<= Status_done $mol_labeler
							title \Message
							Content <= Status_done_view $mol_status
								title \Saved
						<= Status_empty $mol_labeler
							title \Empty status collapses itself
							Content <= Status_empty_view $mol_status
								title \
		speck <= Speck_page $mol_page
			title \$mol_speck
			Logo <= Spread_close
			body /
				<= Specks $mol_list
					rows /
						<= Speck_label $mol_labeler
							title \A count pinned to the corner of what it counts
							Content <= Speck_row $mol_row
								sub /
									<= Speck_inbox $mol_button_minor
										title \Inbox
										error \3
									<= Speck_drafts $mol_button_minor
										title \Drafts
										error \12
									<= Speck_spam $mol_button_minor
										title \Spam
										error \99+
		pop <= Pop_page $mol_page
			title \$mol_pop
			Logo <= Spread_close
			body /
				<= Pops $mol_list
					rows /
						<= Pop_over_label $mol_labeler
							title \$mol_pop_over opens on hover
							Content <= Pop_over $mol_pop_over
								Anchor <= Pop_over_anchor $mol_button_minor
									title \Hover me
								bubble_content /
									<= Pop_over_body $mol_paragraph
										sub /
											\A bubble follows its anchor and flips when it hits an edge.
						<= Pick_label $mol_labeler
							title \$mol_pick opens on click
							Content <= Pick $mol_pick
								title \Pick an action
								bubble_content /
									<= Pick_menu $mol_list
										rows /
											<= Pick_rename $mol_button_minor
												title \Rename
											<= Pick_move $mol_button_minor
												title \Move
											<= Pick_remove $mol_button_minor
												title \Remove

$bog_kit_pager $mol_view
	count 1
	spans /number
	span_total 0
	current 0
	style *
		^
		width <= width_style \100%
	sub <= segments /$mol_view
	Segment* $mol_view
		style *
			^
			flexGrow <= segment_weight* \1
		attr *
			^
			bog_kit_pager_on <= segment_on* false

$mol_text_list $mol_text
	auto_scroll null
	attr *
		^
		mol_text_list_type <= type \
	Paragraph* $mol_text_list_item
		index <= item_index*
		sub <= block_content*

$mol_text_list_item $mol_paragraph
	attr *
		^
		mol_text_list_item_index <= index 0

$bog_kit_app $bog_kit_book
	param \section
	menu_title \$mol Kit
	plugins /
		<= Theme $mol_theme_auto
	menu_tools /
		<= Lights $mol_lights_toggle
	Spread_default <= Intro $mol_page
		title \$mol Kit
		body /
			<= Intro_text $mol_text
				text \
					\# Catalogue of stock $mol components
					\
					\The root is a catalogue of pages. Every section in the menu is a nested catalogue of its own, and every page inside a section holds one family of components.
					\
					\Nothing here has custom styles: everything you see is drawn by the stock components and the default theme.
	spreads *
		controls <= Controls $bog_kit_controls
			Menu_logo <= Spread_close
		fields <= Fields $bog_kit_fields
			Menu_logo <= Spread_close
		layout <= Layout $bog_kit_layout
			Menu_logo <= Spread_close
		data <= Data $bog_kit_data
			Menu_logo <= Spread_close
		feedback <= Feedback $bog_kit_feedback
			Menu_logo <= Spread_close

$bog_kit_switch $mol_switch

$bog_kit_lights_pick $bog_kit_switch
	value? <=> lights? \auto
	options *
		auto \Auto
		light \Light
		dark \Dark

$bog_kit_shell $mol_theme_auto
	attr *
		^
		bog_kit_platform <= platform \ios

$bog_kit_card $mol_card

$bog_kit_button $mol_button_minor

$bog_kit_button_copy $mol_button_copy

$bog_kit_check_icon $mol_check_icon

$bog_kit_select $mol_select

$bog_kit_check_list $mol_check_list

$bog_kit_button_major $mol_button_major

$bog_kit_input $mol_string

$bog_kit_link $mol_link

$bog_kit_check_box $mol_check_box

$bog_kit_check_expand $mol_check_expand

$bog_kit_page $mol_page

$bog_kit_app2 $bog_kit_app
	menu_title \Kit
	kit_chrome true
	Theme $bog_kit_shell
	menu_tools /
		<= Lights_pick $bog_kit_lights_pick
	Intro_text $mol_text
		text \
			\# The same catalogue, drawn by the Kit
			\
			\Nothing in the pages changed. This entry point inherits the whole catalogue from the stock one and hands it a context where the $mol components have been swapped for their Kit subclasses, so every button, field and card on every page is re-drawn without a page being touched.
			\
			\Open the stock build in another tab to compare.

$bog_kit_list $mol_list

$bog_kit_text $mol_text

$bog_kit_label $mol_labeler

$bog_kit_chip $mol_chip

$bog_kit_speck $mol_speck

$bog_kit_status $mol_status

$bog_kit_grid $mol_grid
